<Window x:Class="kovorkingg.Views.CashierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="Кассир – Управление коворкингом" Height="750" Width="1300"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="12" Background="#0D0D0D">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="#7E22CE"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="50" Background="#1E1E1E" CornerRadius="8" Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text="" Foreground="#C084FC" FontSize="16"/>
                        <TextBlock x:Name="txtUserInfo" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0">
                        <Button Content="Бронирования" Background="#7E22CE" Foreground="White" 
        BorderThickness="0" Width="120" Height="30" Margin="0,0,10,0"
        Click="Bookings_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Клиенты" Background="#7E22CE" Foreground="White" 
                                BorderThickness="0" Width="100" Height="30" Margin="0,0,10,0"
                                Click="Clients_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Обновить" Background="#7E22CE" Foreground="White" 
                                BorderThickness="0" Width="100" Height="30" Margin="0,0,10,0"
                                Click="Refresh_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Выход" Background="#9333EA" Foreground="White" 
                                BorderThickness="0" Width="80" Height="30" Click="Exit_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Услуги коворкинга" FontSize="18" FontWeight="Bold" 
                                   Foreground="#C084FC" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtSearch" Grid.Column="0" Height="30" 
                                         Background="#2D2D2D" Foreground="White" 
                                         BorderBrush="#7E22CE" BorderThickness="1"
                                         Padding="10,5" VerticalContentAlignment="Center"
                                         TextChanged="Search_TextChanged">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <ComboBox x:Name="cmbCategoryFilter" Grid.Column="1" Width="150" Height="30" 
                                          Margin="10,0" Background="#2D2D2D" Foreground="Black"
                                          BorderBrush="#7E22CE" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="Все категории"/>
                                    <ComboBoxItem Content="рабочее место"/>
                                    <ComboBoxItem Content="переговорная"/>
                                    <ComboBoxItem Content="услуга"/>
                                </ComboBox>
                                <ComboBox x:Name="cmbSort" Grid.Column="2" Width="150" Height="30"
                                          Background="#2D2D2D" Foreground="black"
                                          BorderBrush="#7E22CE" SelectionChanged="Sort_SelectionChanged">
                                    <ComboBoxItem Content="По названию (А-Я)"/>
                                    <ComboBoxItem Content="По названию (Я-А)"/>
                                    <ComboBoxItem Content="По цене (возр.)"/>
                                    <ComboBoxItem Content="По цене (убыв.)"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <DataGrid x:Name="dgItems" Grid.Row="2" Margin="0,15,0,0" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#2D2D2D" Foreground="White" 
                                  RowBackground="#2D2D2D" AlternatingRowBackground="#3A3A3A"
                                  BorderBrush="#7E22CE" BorderThickness="1"
                                  HeadersVisibility="Column" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionChanged="Items_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="40"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding category}" Width="120"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat={}{0:F2} ₽}" Width="80"/>
                                <DataGridTextColumn Header="Ед.изм." Binding="{Binding unit}" Width="60"/>
                            </DataGrid.Columns>
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#7E22CE"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="30"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5,2"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Новое бронирование" FontSize="18" FontWeight="Bold" 
                                   Foreground="#C084FC" Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Клиент" Foreground="#D8B4FE" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbClients" Height="30" Background="#2D2D2D" Foreground="black"
                                      BorderBrush="#7E22CE" DisplayMemberPath="full_name" SelectedValuePath="id"/>
                            <Button Content="➕ Новый клиент" HorizontalAlignment="Left" Margin="0,5,0,10"
                                    Background="Transparent" Foreground="#A855F7" BorderThickness="0"
                                    Click="AddClient_Click" Cursor="Hand"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Дата" Foreground="#D8B4FE"/>
                                <DatePicker x:Name="dpBookingDate" Height="30" 
                                            Background="#2D2D2D" Foreground="black" 
                                            BorderBrush="#7E22CE" SelectedDate="{x:Static system:DateTime.Today}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Время начала" Foreground="#D8B4FE"/>
                                <TextBox x:Name="txtStartTime" Height="30" Text="09:00" 
                                         Background="#2D2D2D" Foreground="White" BorderBrush="#7E22CE"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                <TextBlock Text="Время окончания" Foreground="#D8B4FE"/>
                                <TextBox x:Name="txtEndTime" Height="30" Text="18:00" 
                                         Background="#2D2D2D" Foreground="White" BorderBrush="#7E22CE"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Выбранные услуги" Foreground="#D8B4FE" Margin="0,0,0,5"/>
                            <DataGrid x:Name="dgCart" Height="150" AutoGenerateColumns="False" 
                                      Background="#2D2D2D" Foreground="White" RowBackground="#2D2D2D"
                                      AlternatingRowBackground="#3A3A3A" BorderBrush="#7E22CE"
                                      CanUserAddRows="False" CanUserDeleteRows="True"
                                      KeyDown="Cart_KeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Услуга" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="70"/>
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/>
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:F2}}" Width="80"/>
                                    <DataGridTemplateColumn Width="30">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Background="Transparent" Foreground="Red"
                                                        Click="RemoveCartItem_Click" Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#7E22CE"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Height" Value="25"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </StackPanel>

                        <Button Grid.Row="4" Content="➕ Добавить выбранную услугу" Height="30" Margin="0,10,0,5"
                                Background="#7E22CE" Foreground="White" BorderThickness="0"
                                Click="AddToCart_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Grid.Row="5" Background="#2D2D2D" CornerRadius="6" Padding="10" 
                                VerticalAlignment="Bottom" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Итого к оплате:" Foreground="#D8B4FE" FontSize="14"/>
                                <TextBlock x:Name="txtTotalAmount" Text="0.00 ₽" FontSize="24" FontWeight="Bold" 
                                           Foreground="#C084FC"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="6" Margin="0,15,0,0">
                            <Button x:Name="btnCreateBooking" Content="Оформить бронирование" Height="40"
                                    Background="#9333EA" Foreground="White" FontWeight="Bold" FontSize="14"
                                    BorderThickness="0" Click="CreateBooking_Click" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Печать PDF" Height="35" Margin="0,10,0,0"
                                    Background="#4C1D95" Foreground="White" BorderThickness="0"
                                    Click="PrintPdf_Click" Cursor="Hand" IsEnabled="False" x:Name="btnPrintPdf">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StatusBar Grid.Row="2" Background="#1E1E1E" Foreground="White" Margin="0,10,0,0" Height="25">
                <StatusBarItem>
                    <TextBlock x:Name="txtStatus" Foreground="#D8B4FE"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Border>
</Window>