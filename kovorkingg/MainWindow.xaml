<Window x:Class="kovorkingg.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="346" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="12" Background="#0D0D0D">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="#7E22CE"/>
        </Border.Effect>
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Коворкинг" FontSize="24" FontWeight="Bold" 
                       Foreground="#C084FC" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Grid.Row="1" Text="Вход в систему" FontSize="16" 
                       Foreground="#A855F7" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Логин" Foreground="#D8B4FE" FontWeight="Medium" Margin="0,0,0,5"/>
                <Border Background="#1E1E1E" BorderBrush="#7E22CE" BorderThickness="1.5" CornerRadius="8">
                    <TextBox x:Name="txtUsername" Height="35" Padding="10,0" 
                             Background="Transparent" Foreground="White" 
                             BorderThickness="0"
                             FontSize="14" VerticalContentAlignment="Center"
                             CaretBrush="White"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="Пароль" Foreground="#D8B4FE" FontWeight="Medium" Margin="0,0,0,5"/>
                <Border Background="#1E1E1E" BorderBrush="#7E22CE" BorderThickness="1.5" CornerRadius="8">
                    <PasswordBox x:Name="txtPassword" Height="35" Padding="10,0" 
                                 Background="Transparent" Foreground="White" 
                                 BorderThickness="0"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 CaretBrush="White"/>
                </Border>
            </StackPanel>

            <Button Grid.Row="4" x:Name="btnLogin" Content="Войти" Height="40"
                    Margin="0,30,0,0" Click="BtnLogin_Click"
                    Background="#9333EA" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" 
                    VerticalAlignment="Top" Background="Transparent" 
                    Foreground="#C084FC" FontSize="16" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
        </Grid>
    </Border>
</Window>