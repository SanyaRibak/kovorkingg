<Window x:Class="kovorkingg.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администратор – Управление коворкингом" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="12" Background="#0D0D0D">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="#7E22CE"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Height="50" Background="#1E1E1E" CornerRadius="8" Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text=" " Foreground="#C084FC" FontSize="16"/>
                        <TextBlock x:Name="txtUserInfo" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0">
                        <Button Content="Сотрудники" Background="#7E22CE" Foreground="White" 
        BorderThickness="0" Width="110" Height="30" Margin="0,0,10,0"
        Click="Employees_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Бронирования" Background="#7E22CE" Foreground="White" 
        BorderThickness="0" Width="120" Height="30" Margin="0,0,10,0"
        Click="Bookings_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Клиенты" Background="#7E22CE" Foreground="White" 
        BorderThickness="0" Width="100" Height="30" Margin="0,0,10,0"
        Click="Clients_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Обновить" Background="#7E22CE" Foreground="White" 
                                BorderThickness="0" Width="100" Height="30" Margin="0,0,10,0"
                                Click="Refresh_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Выход" Background="#9333EA" Foreground="White" 
                                BorderThickness="0" Width="80" Height="30" Click="Exit_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

          
                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Список услуг" FontSize="18" FontWeight="Bold" 
                                   Foreground="#C084FC" Margin="0,0,0,10"/>
   
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtSearch" Grid.Column="0" Height="30" 
                 Background="#2D2D2D" Foreground="White" 
                 BorderBrush="#7E22CE" BorderThickness="1"
                 Padding="10,5" VerticalContentAlignment="Center"
                 TextChanged="Search_TextChanged">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <TextBlock Grid.Column="0" Text="" Foreground="#888" 
                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" 
                   />
                            </Grid>
                        </StackPanel>
                        <DataGrid x:Name="dgItems" Grid.Row="1" AutoGenerateColumns="False" Margin="0,40,0,0"
                                  IsReadOnly="True" Background="#2D2D2D" Foreground="White" 
                                  RowBackground="#2D2D2D" AlternatingRowBackground="#3A3A3A"
                                  BorderBrush="#7E22CE" BorderThickness="1"
                                  HeadersVisibility="Column" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionChanged="Items_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="40"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding category}" Width="120"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat={}{0:F2} ₽}" Width="80"/>
                                <DataGridTextColumn Header="Ед." Binding="{Binding unit}" Width="50"/>
                                <DataGridCheckBoxColumn Header="Активна" Binding="{Binding is_active}" Width="60"/>
                            </DataGrid.Columns>
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#7E22CE"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="30"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5,2"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>




                    </Grid>
                </Border>

           
                <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="lblFormTitle" Text="Добавление услуги" FontSize="18" FontWeight="Bold" 
                                   Foreground="#C084FC" Margin="0,0,0,15"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Название" Foreground="#D8B4FE" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtName" Height="30" Background="#2D2D2D" Foreground="White" 
                                         BorderBrush="#7E22CE" Margin="0,0,0,10"/>

                                <TextBlock Text="Описание" Foreground="#D8B4FE" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtDescription" Height="80" Background="#2D2D2D" Foreground="White" 
                                         BorderBrush="#7E22CE" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                <TextBlock Text="Категория" Foreground="#D8B4FE" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbCategory" Height="30" Background="#2D2D2D" Foreground="black"
                                          BorderBrush="#7E22CE" Margin="0,0,0,10">
                                    <ComboBoxItem Content="рабочее место"/>
                                    <ComboBoxItem Content="переговорная"/>
                                    <ComboBoxItem Content="услуга"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Цена (₽)" Foreground="#D8B4FE"/>
                                        <TextBox x:Name="txtPrice" Height="30" Background="#2D2D2D" Foreground="White" 
                                                 BorderBrush="#7E22CE"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Единица измерения" Foreground="#D8B4FE"/>
                                        <ComboBox x:Name="cmbUnit" Height="30" Background="#2D2D2D" Foreground="black"
                                                  BorderBrush="#7E22CE">
                                            <ComboBoxItem Content="hour"/>
                                            <ComboBoxItem Content="day"/>
                                            <ComboBoxItem Content="piece"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="chkIsActive" Content="Услуга активна" Foreground="White" 
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnAdd" Content="Добавить" Grid.Column="0" Height="35"
                                        Background="#7E22CE" Foreground="White" BorderThickness="0"
                                        Click="Add_Click" Cursor="Hand" Margin="0,0,5,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnSave" Content="Сохранить" Grid.Column="1" Height="35"
                                        Background="#9333EA" Foreground="White" BorderThickness="0"
                                        Click="Save_Click" Cursor="Hand" Margin="5,0,0,0" IsEnabled="False">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnDelete" Content="Удалить" Grid.Column="0" Height="35"
                                        Background="#C53030" Foreground="White" BorderThickness="0"
                                        Click="Delete_Click" Cursor="Hand" Margin="0,0,5,0" IsEnabled="False">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnCancel" Content="Отмена" Grid.Column="1" Height="35"
                                        Background="#555" Foreground="White" BorderThickness="0"
                                        Click="Cancel_Click" Cursor="Hand" Margin="5,0,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

 
            <StatusBar Grid.Row="2" Background="#1E1E1E" Foreground="White" Margin="0,10,0,0" Height="25">
                <StatusBarItem>
                    <TextBlock x:Name="txtStatus" Foreground="#D8B4FE"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Border>
</Window>