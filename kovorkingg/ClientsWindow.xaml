<Window x:Class="kovorkingg.Views.ClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиенты" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="12" Background="#0D0D0D">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="#7E22CE"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Height="50" Background="#1E1E1E" CornerRadius="8" Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text="" Foreground="#C084FC" FontSize="16"/>
                        <TextBlock Text="Управление клиентами" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0">
                        <Button Content="Обновить" Background="#7E22CE" Foreground="White" 
                                BorderThickness="0" Width="100" Height="30" Margin="0,0,10,0"
                                Click="Refresh_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Закрыть" Background="#9333EA" Foreground="White" 
                                BorderThickness="0" Width="80" Height="30" Click="Close_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Список клиентов" FontSize="18" FontWeight="Bold" 
                                   Foreground="#C084FC" Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="txtSearch" Height="30" 
                                     Background="#2D2D2D" Foreground="White" 
                                     BorderBrush="#7E22CE" BorderThickness="1"
                                     Padding="10,5" VerticalContentAlignment="Center"
                                     TextChanged="Search_TextChanged"/>
                        </StackPanel>


                        <DataGrid x:Name="dgClients" Grid.Row="1" AutoGenerateColumns="False" Margin="0,35,0,0"
                                  IsReadOnly="True" Background="#2D2D2D" Foreground="White" 
                                  RowBackground="#2D2D2D" AlternatingRowBackground="#3A3A3A"
                                  BorderBrush="#7E22CE" BorderThickness="1"
                                  HeadersVisibility="Column" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionChanged="Clients_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="40"/>
                                <DataGridTextColumn Header="ФИО / Название" Binding="{Binding full_name}" Width="*"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding phone}" Width="140"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="180"/>
                            </DataGrid.Columns>
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#7E22CE"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="30"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5,2"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="lblFormTitle" Text="Добавление клиента" FontSize="18" FontWeight="Bold" 
                                   Foreground="#C084FC" Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="ФИО / Название" Foreground="#D8B4FE" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtFullName" Height="30" Background="#2D2D2D" Foreground="White" 
                                     BorderBrush="#7E22CE" Margin="0,0,0,15"/>

                            <TextBlock Text="Телефон" Foreground="#D8B4FE" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtPhone" Height="30" Background="#2D2D2D" Foreground="White" 
                                     BorderBrush="#7E22CE" Margin="0,0,0,15"/>

                            <TextBlock Text="Email" Foreground="#D8B4FE" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtEmail" Height="30" Background="#2D2D2D" Foreground="White" 
                                     BorderBrush="#7E22CE" Margin="0,0,0,15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnAdd" Content="Добавить" Grid.Column="0" Height="35"
                                        Background="#7E22CE" Foreground="White" BorderThickness="0"
                                        Click="Add_Click" Cursor="Hand" Margin="0,0,5,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnSave" Content="Сохранить" Grid.Column="1" Height="35"
                                        Background="#9333EA" Foreground="White" BorderThickness="0"
                                        Click="Save_Click" Cursor="Hand" Margin="5,0,0,0" IsEnabled="False">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnDelete" Content="Удалить" Grid.Column="0" Height="35"
                                        Background="#C53030" Foreground="White" BorderThickness="0"
                                        Click="Delete_Click" Cursor="Hand" Margin="0,0,5,0" IsEnabled="False">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnCancel" Content="Отмена" Grid.Column="1" Height="35"
                                        Background="#555" Foreground="White" BorderThickness="0"
                                        Click="Cancel_Click" Cursor="Hand" Margin="5,0,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StatusBar Grid.Row="2" Background="#1E1E1E" Foreground="White" Margin="0,10,0,0" Height="25">
                <StatusBarItem>
                    <TextBlock x:Name="txtStatus" Foreground="#D8B4FE"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Border>
</Window>