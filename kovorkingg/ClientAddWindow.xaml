<Window x:Class="kovorkingg.Views.ClientAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый клиент" Height="280" Width="380" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="10" Background="#0D0D0D" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Новый клиент" FontSize="16" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="ФИО / Название" Foreground="#D8B4FE"/>
                <TextBox x:Name="txtFullName" Height="30" Background="#1E1E1E" Foreground="White" 
                         BorderBrush="#7E22CE" Margin="0,0,0,10"/>
                <TextBlock Text="Телефон" Foreground="#D8B4FE"/>
                <TextBox x:Name="txtPhone" Height="30" Background="#1E1E1E" Foreground="White" 
                         BorderBrush="#7E22CE" Margin="0,0,0,10"/>
                <TextBlock Text="Email" Foreground="#D8B4FE"/>
                <TextBox x:Name="txtEmail" Height="30" Background="#1E1E1E" Foreground="White" 
                         BorderBrush="#7E22CE"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Сохранить" Width="80" Height="30" Background="#9333EA" Foreground="White" 
                        BorderThickness="0" Click="Save_Click" Margin="0,0,10,0"/>
                <Button Content="Отмена" Width="80" Height="30" Background="#555" Foreground="White" 
                        BorderThickness="0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>